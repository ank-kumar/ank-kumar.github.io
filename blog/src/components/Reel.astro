---
import fs from 'node:fs';
import path from 'node:path';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let files = [];
try {
  const mosaicPath = path.join(process.cwd(), 'public/mosaic');
  files = fs.readdirSync(mosaicPath).filter((f) => /\.(jpe?g|png|webp)$/i.test(f));
} catch (e) { 
  console.error('Reel error:', e.message);
  files = []; 
}
files.sort();

const rows = [
  files.filter((_, i) => i % 5 === 0),
  files.filter((_, i) => i % 5 === 1),
  files.filter((_, i) => i % 5 === 2),
  files.filter((_, i) => i % 5 === 3),
  files.filter((_, i) => i % 5 === 4),
].map((row, idx) => ({
  items: row,
  duration: ['90s', '125s', '105s', '140s', '95s'][idx],
  reverse: [false, true, false, true, false][idx],
}));
---
<div class="wall" aria-hidden="true">
  {rows.map((row) => (
    <div class="row" style={`--duration: ${row.duration}; ${row.reverse ? 'animation-direction: reverse;' : ''}`}>
      {[...row.items, ...row.items].map((f) => (
        <img src={base + '/mosaic/' + f} alt="" loading="lazy" />
      ))}
    </div>
  ))}
</div>
